<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121212"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />

        <TextView
            style="@style/SectionHead"
            android:text="プレビュー" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/preview_wallpaper"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/preview_week"
                    android:layout_width="180dp"
                    android:layout_height="64dp" />

                <FrameLayout
                    android:id="@+id/preview_month"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            style="@style/SectionHead"
            android:text="背景色" />
        <RadioGroup
            android:id="@+id/rg_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rb_bg_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:buttonTint="#FFE53935"
                android:text="黒"
                android:textColor="#FFEDEDED"
                android:textSize="15sp" />
            <RadioButton
                android:id="@+id/rb_bg_gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:buttonTint="#FFE53935"
                android:text="グレー"
                android:textColor="#FFEDEDED"
                android:textSize="15sp" />
            <RadioButton
                android:id="@+id/rb_bg_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:buttonTint="#FFE53935"
                android:text="白"
                android:textColor="#FFEDEDED"
                android:textSize="15sp" />
            <RadioButton
                android:id="@+id/rb_bg_navy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:buttonTint="#FFE53935"
                android:text="紺"
                android:textColor="#FFEDEDED"
                android:textSize="15sp" />
        </RadioGroup>
        <TextView
            android:id="@+id/alpha_label"
            style="@style/SectionHead" />

        <SeekBar
            android:id="@+id/seek_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progressTint="#FFE53935"
            android:thumbTint="#FFE53935" />

        <TextView
            style="@style/SectionHead"
            android:text="文字色" />
        <RadioGroup
            android:id="@+id/rg_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rb_text_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:buttonTint="#FFE53935"
                android:text="白"
                android:textColor="#FFEDEDED"
                android:textSize="15sp" />
            <RadioButton
                android:id="@+id/rb_text_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:buttonTint="#FFE53935"
                android:text="黒"
                android:textColor="#FFEDEDED"
                android:textSize="15sp" />
        </RadioGroup>
        <TextView
            style="@style/SectionHead"
            android:text="今日の丸の色" />
        <RadioGroup
            android:id="@+id/rg_accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rb_ac_red"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:buttonTint="#FFE53935"
                android:text="赤"
                android:textColor="#FFEDEDED"
                android:textSize="15sp" />
            <RadioButton
                android:id="@+id/rb_ac_blue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:buttonTint="#FFE53935"
                android:text="青"
                android:textColor="#FFEDEDED"
                android:textSize="15sp" />
            <RadioButton
                android:id="@+id/rb_ac_yellow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:buttonTint="#FFE53935"
                android:text="黄"
                android:textColor="#FFEDEDED"
                android:textSize="15sp" />
            <RadioButton
                android:id="@+id/rb_ac_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:buttonTint="#FFE53935"
                android:text="白"
                android:textColor="#FFEDEDED"
                android:textSize="15sp" />
        </RadioGroup>
        <TextView
            style="@style/SectionHead"
            android:text="週の始まり" />
        <RadioGroup
            android:id="@+id/rg_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rb_sun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:buttonTint="#FFE53935"
                android:text="日曜"
                android:textColor="#FFEDEDED"
                android:textSize="15sp" />
            <RadioButton
                android:id="@+id/rb_mon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:buttonTint="#FFE53935"
                android:text="月曜"
                android:textColor="#FFEDEDED"
                android:textSize="15sp" />
        </RadioGroup>
        <Switch
            android:id="@+id/sw_holiday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="祝日を赤で表示"
            android:textColor="#FFEDEDED"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="#FFE53935"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_pin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="#FF2A2A2A"
            android:text="ホーム画面に追加"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#FF9A9A9A"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
