<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/widget_bg" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical"
        android:paddingStart="12dp" android:paddingTop="10dp" android:paddingEnd="12dp" android:paddingBottom="10dp">
        <include layout="@layout/part_s" />
        <LinearLayout android:id="@+id/daily_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" />
    </LinearLayout>
    <ImageView android:id="@+id/ghost" android:layout_width="36dp" android:layout_height="46dp" android:layout_gravity="top|end" android:layout_marginTop="26dp" android:layout_marginEnd="12dp" android:contentDescription="おばけ" android:scaleType="fitCenter" android:visibility="gone" />
</FrameLayout>
