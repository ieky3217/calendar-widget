<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/widget_bg" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="14dp" android:paddingTop="8dp" android:paddingEnd="14dp" android:paddingBottom="8dp">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" >
<TextView android:id="@+id/place" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="11sp" android:singleLine="true" android:fontFamily="sans-serif-medium" android:ellipsize="end" android:maxWidth="96dp"/><TextView android:id="@+id/event_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="28sp" android:singleLine="true" android:fontFamily="sans-serif-medium" android:layout_marginTop="3dp"/><TextView android:id="@+id/remain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="11sp" android:singleLine="true" android:layout_marginTop="4dp"/>
</LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="14dp">
<TextView android:id="@+id/sub1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="11sp" android:singleLine="true"/><ImageView android:id="@+id/strip" android:layout_width="match_parent" android:layout_height="14dp" android:contentDescription="@null" android:scaleType="fitXY" android:layout_marginTop="6dp"/><TextView android:id="@+id/sub2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="11sp" android:singleLine="true" android:layout_marginTop="4dp"/>
</LinearLayout><ImageView android:id="@+id/moon" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@null" android:scaleType="fitCenter" android:layout_marginStart="12dp"/><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
<TextView android:id="@+id/moon_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="12sp" android:singleLine="true" android:fontFamily="sans-serif-medium"/><TextView android:id="@+id/moon_age" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="11sp" android:singleLine="true" android:layout_marginTop="3dp"/><TextView android:id="@+id/moon_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="11sp" android:singleLine="true" android:layout_marginTop="2dp"/>
</LinearLayout>
</LinearLayout>
</FrameLayout>
