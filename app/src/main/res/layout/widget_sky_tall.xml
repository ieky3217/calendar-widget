<?xml version="1.0" encoding="utf-8"?>
<!-- 日の出・月 2×2：上＝月（絵＋短い数値）、中＝月相の行（全幅）、下＝日の入り／日の出と24時間帯 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/widget_bg" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="12dp" android:paddingTop="10dp" android:paddingEnd="12dp" android:paddingBottom="10dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/moon" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="@null" android:scaleType="fitCenter" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/moon_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="15sp" android:singleLine="true" android:fontFamily="sans-serif-medium"/>
                <TextView android:id="@+id/moon_jp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="10sp" android:singleLine="true" android:layout_marginTop="3dp"/>
                <TextView android:id="@+id/moon_age" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="11sp" android:singleLine="true" android:layout_marginTop="3dp"/>
            </LinearLayout>
            <TextView android:id="@+id/place" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="11sp" android:singleLine="true" android:fontFamily="sans-serif-medium" android:ellipsize="end" android:maxWidth="60dp" android:layout_gravity="top"/>
        </LinearLayout>
        <TextView android:id="@+id/moon_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" android:layout_marginTop="6dp"/>
        <FrameLayout android:id="@+id/divider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="bottom" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/event_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="11sp" android:singleLine="true"/>
                <TextView android:id="@+id/event_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="26sp" android:singleLine="true" android:fontFamily="sans-serif-medium" android:layout_marginTop="3dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical">
                <TextView android:id="@+id/sub1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="11sp" android:singleLine="true"/>
                <TextView android:id="@+id/remain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="11sp" android:singleLine="true" android:layout_marginTop="3dp"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView android:id="@+id/strip" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="8dp" android:contentDescription="@null" android:scaleType="fitXY" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
