<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/widget_bg" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="14dp" android:paddingTop="8dp" android:paddingEnd="14dp" android:paddingBottom="8dp">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" >
<TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="11sp" android:singleLine="true"/><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:gravity="bottom">
<TextView android:id="@+id/value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="26sp" android:singleLine="true" android:fontFamily="sans-serif-medium"/><TextView android:id="@+id/unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="10sp" android:singleLine="true" android:layout_marginStart="3dp" android:text="hPa"/>
</LinearLayout><TextView android:id="@+id/delta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="11sp" android:singleLine="true" android:layout_marginTop="4dp"/>
</LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="14dp">
<ImageView android:id="@+id/chart" android:layout_width="match_parent" android:layout_height="42dp" android:contentDescription="@null" android:scaleType="fitXY" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="3dp" android:gravity="center_vertical">
<ImageView android:id="@+id/obs" android:layout_width="13dp" android:layout_height="16dp" android:contentDescription="@null" android:scaleType="fitCenter"/><TextView android:id="@+id/msg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="11sp" android:singleLine="true" android:layout_marginStart="4dp" android:ellipsize="end"/>
</LinearLayout>
</LinearLayout>
</LinearLayout>
</FrameLayout>
