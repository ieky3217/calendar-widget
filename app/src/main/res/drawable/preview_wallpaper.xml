<?xml version="1.0" encoding="utf-8"?>
<!-- 透過具合を確認するための壁紙風の背景 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#FF2E5AAC" />
    </item>
    <item android:width="170dp" android:height="150dp" android:gravity="top|start">
        <shape android:shape="rectangle">
            <solid android:color="#FFF2C230" />
        </shape>
    </item>
    <item android:width="200dp" android:height="200dp" android:gravity="bottom|end">
        <shape android:shape="oval">
            <solid android:color="#FFD7263D" />
        </shape>
    </item>
    <item android:width="90dp" android:height="260dp" android:gravity="center_vertical|start">
        <shape android:shape="rectangle">
            <solid android:color="#FFF4F1EA" />
        </shape>
    </item>
</layer-list>
